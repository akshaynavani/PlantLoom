# Optional overrides; PlantLoom needs no credentials.
PORT=8080
# Fraction of equipment jobs that fail / hang (exercise retries and timeouts)
PLANTLOOM_FAILURE_RATE=0.05
PLANTLOOM_HANG_RATE=0.01
# <1 speeds up the simulation, >1 slows it down
PLANTLOOM_TIME_SCALE=1.0
# Alternative location for workflow YAML files, e.g. file:./workflows/*.yml
PLANTLOOM_DEFINITIONS=classpath:workflows/*.yml
# json -> ECS structured logs, load -> burst load simulation on startup
SPRING_PROFILES_ACTIVE=
